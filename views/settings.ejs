<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Profile Settings</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-5" style="max-width: 600px;">
      <div class="card p-4 shadow-sm border-0 mb-5">
        <h2 class="fw-bold mb-4">Edit Profile Settings</h2>

        <% if (locals.error) { %>
          <div class="alert alert-danger" role="alert"><%= locals.error %></div>
        <% } %>

        <form action="/user/settings" method="post" enctype="multipart/form-data">
          <!-- Full Name -->
          <div class="mb-3">
            <label for="fullName" class="form-label fw-semibold">Full Name</label>
            <input
              type="text"
              class="form-control"
              id="fullName"
              name="fullName"
              value="<%= user.fullName %>"
              required
            />
          </div>

          <!-- Profile Image -->
          <div class="mb-3">
            <label for="profileImage" class="form-label fw-semibold">Profile Picture</label>
            <div class="d-flex align-items-center gap-3 mb-2">
              <img
                src="<%= user.profileImageURL %>"
                alt="Current profile image"
                class="rounded-circle"
                style="width: 50px; height: 50px; object-fit: cover;"
              />
              <span class="text-muted" style="font-size: 0.9rem;">Current Avatar</span>
            </div>
            <input
              type="file"
              class="form-control"
              id="profileImage"
              name="profileImage"
              accept="image/*"
            />
            <small class="text-muted">Max size: 10 MB. Allowed: JPEG, PNG, WEBP, GIF.</small>
          </div>

          <!-- Bio -->
          <div class="mb-3">
            <label for="bio" class="form-label fw-semibold">Short Bio</label>
            <textarea
              class="form-control"
              id="bio"
              name="bio"
              rows="3"
              placeholder="Tell others about yourself..."
            ><%= user.bio || '' %></textarea>
            <small class="text-muted">Enforced limit: 200 characters.</small>
          </div>

          <hr class="my-4"/>

          <!-- Social URLs -->
          <h5 class="fw-bold mb-3">Social Links</h5>
          <div class="mb-3">
            <label for="twitterURL" class="form-label fw-semibold"><i class="bi bi-twitter-x me-1"></i> Twitter / X URL</label>
            <input
              type="url"
              class="form-control"
              id="twitterURL"
              name="twitterURL"
              placeholder="https://x.com/username"
              value="<%= user.twitterURL || '' %>"
            />
          </div>

          <div class="mb-3">
            <label for="githubURL" class="form-label fw-semibold"><i class="bi bi-github me-1"></i> GitHub URL</label>
            <input
              type="url"
              class="form-control"
              id="githubURL"
              name="githubURL"
              placeholder="https://github.com/username"
              value="<%= user.githubURL || '' %>"
            />
          </div>

          <div class="mb-3">
            <label for="websiteURL" class="form-label fw-semibold"><i class="bi bi-globe me-1"></i> Personal Website</label>
            <input
              type="url"
              class="form-control"
              id="websiteURL"
              name="websiteURL"
              placeholder="https://yourwebsite.com"
              value="<%= user.websiteURL || '' %>"
            />
          </div>

          <hr class="my-4"/>

          <!-- Security / Password Change -->
          <h5 class="fw-bold mb-3">Security Settings</h5>
          <div class="mb-4">
            <label for="password" class="form-label fw-semibold">New Password</label>
            <input
              type="password"
              class="form-control"
              id="password"
              name="password"
              placeholder="Enter new password"
            />
            <small class="text-muted">Leave blank to keep your current password. Minimum 6 characters.</small>
          </div>

          <!-- Buttons -->
          <div class="d-flex gap-2 justify-content-end">
            <a href="/user/profile/<%= user._id %>" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save Changes</button>
          </div>
        </form>
      </div>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
