<nav class="site-nav navbar navbar-expand-lg" data-bs-theme="dark">
  <div class="container">
    <a class="navbar-brand site-brand" href="/">
      <i class="bi bi-stack me-1"></i>Blog Chunks
    </a>
    <button
      class="navbar-toggler border-0"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarMain"
      aria-controls="navbarMain"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMain">
      <ul class="navbar-nav me-auto gap-1">
        <li class="nav-item">
          <a class="nav-link" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
        </li>
        <% if (locals.user) { %>
        <li class="nav-item">
          <a class="nav-link" href="/blog/add-new"><i class="bi bi-plus-circle me-1"></i>Write</a>
        </li>
        <% } %>
      </ul>

      <ul class="navbar-nav align-items-center gap-2 ms-auto">
        <% if (locals.user) { %>
        <li class="nav-item dropdown">
          <a
            class="nav-link dropdown-toggle d-flex align-items-center gap-2"
            href="#"
            role="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            <img
              src="<%= user.profileImageURL %>"
              width="28" height="28"
              class="rounded-circle"
              style="object-fit:cover; border: 2px solid rgba(255,255,255,0.2);"
            />
            <span class="d-none d-md-inline"><%= user.fullName %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 200px; border-radius: 10px; margin-top: 0.5rem;">
            <li class="px-3 py-2">
              <p class="mb-0 fw-semibold" style="font-size: 0.9rem;"><%= user.fullName %></p>
              <p class="mb-0 text-muted" style="font-size: 0.78rem;"><%= user.email %></p>
            </li>
            <li><hr class="dropdown-divider my-1"></li>
            <li><a class="dropdown-item py-2" href="/user/profile/<%= user._id %>"><i class="bi bi-person me-2 text-primary"></i>My Profile</a></li>
            <li><a class="dropdown-item py-2" href="/blog/my-blogs"><i class="bi bi-journal-text me-2 text-primary"></i>My Blogs</a></li>
            <li><a class="dropdown-item py-2" href="/user/settings"><i class="bi bi-gear me-2 text-primary"></i>Settings</a></li>
            <li><hr class="dropdown-divider my-1"></li>
            <li><a class="dropdown-item py-2 text-danger" href="/user/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
          </ul>
        </li>
        <% } else { %>
        <li class="nav-item">
          <a class="btn-nav-outline btn" href="/user/signin">Sign in</a>
        </li>
        <li class="nav-item">
          <a class="btn-nav-primary btn" href="/user/signup">Get Started</a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>

<% if (locals.error) { %>
<div class="container mt-3">
  <div class="alert flash-alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <%= locals.error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>
