<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog Chunks — Read. Write. Create</title>
    <meta name="description" content="Discover insightful articles on technology, lifestyle, and everything even some random in between. Join the Blog Chunks community today.">
  </head>
  <body>
    <%- include('./partials/nav') %>

    <% if (!locals.user) { %>
    <section class="hero-section">
      <div class="container position-relative" style="z-index: 1;">
        <div class="row align-items-center">
          <div class="col-lg-7">
            <span class="hero-badge">
              <i class="bi bi-stars"></i> A space for great ideas
            </span>
            <h1 class="hero-title">
              Stories that <span class="hero-highlight"> express </span><br>
              Ideas that <span class="hero-highlight">matters.</span>
            </h1>
            <p class="hero-subtitle">
              Discover thoughtful articles on tech, creativity, culture and every thoughts about here and there, Written by people who care about their craft.
            </p>
            <div class="hero-cta-group">
              <a href="/user/signup" class="btn-hero-primary">
                <i class="bi bi-pencil-square"></i> Start Writing
              </a>
              <a href="#latest" class="btn-hero-ghost">
                <i class="bi bi-arrow-down-circle"></i> Browse Articles
              </a>
            </div>
            <div class="hero-stats">
              <div>
                <div class="hero-stat-num"><%= totalBlogs %>+</div>
                <div class="hero-stat-label">Articles</div>
              </div>
              <div>
                <div class="hero-stat-num">Free</div>
                <div class="hero-stat-label">Always</div>
              </div>
              <div>
                <div class="hero-stat-num"><i class="bi bi-heart-fill" style="font-size: 1.5rem; color: #f43f5e;"></i></div>
                <div class="hero-stat-label">Community Driven</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <% } else { %>
    <!-- Logged-in greeting banner -->
    <section style="background: linear-gradient(135deg, #0f172a, #1e1b4b); padding: 2rem 0; border-bottom: 1px solid rgba(255,255,255,0.07);">
      <div class="container d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
          <img src="<%= user.profileImageURL %>" width="42" height="42" class="rounded-circle" style="object-fit:cover; border: 2px solid rgba(99,102,241,0.5);">
          <div>
            <p class="mb-0" style="color: rgba(255,255,255,0.5); font-size: 0.8rem;">Welcome back,</p>
            <p class="mb-0 fw-bold" style="color: #fff; font-size: 1.05rem;"><%= user.fullName %></p>
          </div>
        </div>
        <a href="/blog/add-new" class="btn-hero-primary" style="font-size: 0.875rem; padding: 0.5rem 1.25rem;">
          <i class="bi bi-plus-lg"></i> New Article
        </a>
      </div>
    </section>
    <% } %>

    <main class="container py-5" id="latest">

      <!-- Section header -->
      <div class="section-header">
        <div>
          <h2 class="section-title">
            <% if (selectedCategory) { %>
              <%= selectedCategory %> Articles
            <% } else { %>
              Explore Articles
            <% } %>
          </h2>
          <p class="text-muted mb-0" style="font-size: 0.875rem;">
            Showing <%= totalBlogs %> <%= totalBlogs === 1 ? 'article' : 'articles' %>
            <% if (selectedCategory || searchQuery || selectedSort !== 'latest') { %>
              matching your filters
            <% } %>
          </p>
        </div>
        <% if (totalPages > 1) { %>
          <div class="badge bg-light text-dark border px-3 py-2" style="font-size: 0.85rem; font-weight: 500;">
            Page <%= currentPage %> of <%= totalPages %>
          </div>
        <% } %>
      </div>

      <% if (locals.user) { %>
      <!-- Professional Filter & Search Toolbar (Logged-in) -->
      <div class="filter-toolbar">
        <form action="/" method="GET" id="filter-form" class="row g-3 align-items-center">
          <!-- Search input -->
          <div class="col-lg-4 col-md-6">
            <div class="search-input-group">
              <i class="bi bi-search search-icon"></i>
              <input 
                type="text" 
                name="q" 
                class="form-control" 
                placeholder="Search articles by title, content or tags..." 
                value="<%= locals.searchQuery || '' %>"
              />
            </div>
          </div>

          <!-- Sort dropdown -->
          <div class="col-lg-3 col-md-6">
            <select name="sort" class="form-select filter-select" onchange="document.getElementById('filter-form').submit();">
              <option value="latest" <%= (locals.selectedSort === 'latest' || !locals.selectedSort) ? 'selected' : '' %>>Sort by: Latest</option>
              <option value="popular" <%= locals.selectedSort === 'popular' ? 'selected' : '' %>>Sort by: Most Viewed</option>
              <option value="liked" <%= locals.selectedSort === 'liked' ? 'selected' : '' %>>Sort by: Most Liked</option>
              <option value="oldest" <%= locals.selectedSort === 'oldest' ? 'selected' : '' %>>Sort by: Oldest First</option>
            </select>
          </div>

          <!-- Hidden category input -->
          <input type="hidden" name="category" id="selected-category-input" value="<%= locals.selectedCategory || '' %>" />

          <!-- Category Pills -->
          <div class="col-lg-5 col-12">
            <div class="category-pills-wrap">
              <a href="/?sort=<%= locals.selectedSort || 'latest' %>&q=<%= encodeURIComponent(locals.searchQuery || '') %>" 
                 class="category-pill-btn <%= !locals.selectedCategory ? 'active' : '' %>">
                All Topics
              </a>
              <% if (locals.categories && locals.categories.length > 0) { %>
                <% locals.categories.forEach(cat => { %>
                  <a href="/?category=<%= encodeURIComponent(cat) %>&sort=<%= locals.selectedSort || 'latest' %>&q=<%= encodeURIComponent(locals.searchQuery || '') %>" 
                     class="category-pill-btn <%= locals.selectedCategory === cat ? 'active' : '' %>">
                    <i class="bi bi-tag-fill text-muted me-1" style="font-size: 0.75rem;"></i><%= cat %>
                  </a>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- Active filters badge / clear button -->
          <% if (locals.selectedCategory || locals.searchQuery || (locals.selectedSort && locals.selectedSort !== 'latest')) { %>
            <div class="col-12 d-flex align-items-center justify-content-between pt-2 border-top">
              <span class="text-muted" style="font-size: 0.85rem;">
                Active Filters: 
                <% if (locals.selectedCategory) { %><span class="badge bg-primary me-1"><%= locals.selectedCategory %></span><% } %>
                <% if (locals.searchQuery) { %><span class="badge bg-info text-dark me-1">"<%= locals.searchQuery %>"</span><% } %>
                <% if (locals.selectedSort && locals.selectedSort !== 'latest') { %><span class="badge bg-secondary me-1"><%= locals.selectedSort %></span><% } %>
              </span>
              <a href="/" class="btn btn-sm btn-outline-danger" style="font-size: 0.78rem;">
                <i class="bi bi-x-circle me-1"></i> Clear Filters
              </a>
            </div>
          <% } %>
        </form>
      </div>
      <% } else { %>
      <!-- Simple Search for Visitors -->
      <div class="filter-toolbar mb-4">
        <form action="/" method="GET" class="row justify-content-center">
          <div class="col-lg-8">
            <div class="search-input-group" style="box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-radius: 50px; background: white;">
              <i class="bi bi-search search-icon" style="left: 1.5rem; color: #a3a3a3;"></i>
              <input 
                type="text" 
                name="q" 
                class="form-control border-0" 
                style="border-radius: 50px; padding: 1rem 1rem 1rem 3.5rem; font-size: 1.1rem; background: transparent; box-shadow: none;"
                placeholder="Search articles..." 
                value="<%= locals.searchQuery || '' %>"
              />
              <button type="submit" class="btn position-absolute" style="right: 0.5rem; top: 0.5rem; bottom: 0.5rem; background: #292524; color: white; border-radius: 50px; padding: 0 1.5rem; font-weight: 500;">Search</button>
            </div>
            <% if (locals.searchQuery) { %>
              <div class="text-center mt-3">
                <span class="text-muted" style="font-size: 0.9rem;">
                  Showing results for: <strong style="color: #292524;">"<%= locals.searchQuery %>"</strong>
                </span>
                <a href="/" class="text-muted ms-2" style="font-size: 0.85rem; text-decoration: underline;">Clear search</a>
              </div>
            <% } %>
          </div>
        </form>
      </div>
      <% } %>

      <% if (blogs.length === 0) { %>
      <!-- Empty state -->
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-journal-x"></i></div>
        <h3>No articles found</h3>
        <p>Try refining your search keyword or selecting a different category.</p>
        <div class="d-flex justify-content-center gap-2">
          <a href="/" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-counterclockwise"></i> Reset Filters</a>
          <% if (locals.user) { %>
            <a href="/blog/add-new" class="btn-hero-primary" style="font-size: 0.85rem; padding: 0.4rem 1rem;">
              <i class="bi bi-pencil-square"></i> Create Post
            </a>
          <% } %>
        </div>
      </div>

      <% } else { %>

      <!-- Card grid -->
      <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 blog-grid">
        <% blogs.forEach((blog, i) => { %>
        <div class="col fade-up">
          <article class="blog-card" onclick="window.location='/blog/<%= blog._id %>'" style="cursor: pointer;">
            <!-- Cover image -->
            <div class="blog-card-img-wrap">
              <% if (blog.coverImageURL) { %>
                <img class="blog-card-img" src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" loading="lazy"/>
              <% } else { %>
                <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #e0e7ff, #ede9fe);">
                  <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                </div>
              <% } %>
              <% if (blog.category) { %>
                <span class="blog-card-category"><%= blog.category %></span>
              <% } %>
            </div>

            <!-- Body -->
            <div class="blog-card-body">
              <!-- Author & date row -->
              <div class="blog-card-author">
                <% if (blog.createdBy && blog.createdBy.profileImageURL) { %>
                  <img class="blog-card-author-img" src="<%= blog.createdBy.profileImageURL %>" alt="<%= blog.createdBy.fullName %>"/>
                <% } %>
                <span class="blog-card-author-name">
                  <%= blog.createdBy ? blog.createdBy.fullName : 'Anonymous' %>
                </span>
                <span class="blog-card-date ms-auto">
                  <%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                </span>
              </div>

              <!-- Title -->
              <h3 class="blog-card-title"><%= blog.title %></h3>

              <!-- Excerpt from body -->
              <p class="blog-card-excerpt">
                <%= blog.body.replace(/<[^>]*>/g, '').substring(0, 140) %>...
              </p>

              <!-- Tags -->
              <% if (blog.tags && blog.tags.length > 0) { %>
                <div class="d-flex flex-wrap gap-1 mb-2">
                  <% blog.tags.slice(0, 3).forEach(tag => { %>
                    <span class="tag-pill">#<%= tag %></span>
                  <% }) %>
                </div>
              <% } %>

              <!-- Footer -->
              <div class="blog-card-footer">
                <div class="blog-card-meta">
                  <span><i class="bi bi-eye"></i> <%= blog.views %></span>
                  <span><i class="bi bi-clock"></i> <%= blog.readingTime %> min</span>
                  <% if (blog.likes) { %>
                    <span><i class="bi bi-heart"></i> <%= blog.likes.length %></span>
                  <% } %>
                </div>
                <a href="/blog/<%= blog._id %>" class="blog-card-read-btn" onclick="event.stopPropagation()">
                  Read <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </article>
        </div>
        <% }) %>
      </div>

      <% 
        function buildPageUrl(pageNum) {
          const params = new URLSearchParams();
          params.set('page', pageNum);
          if (locals.selectedCategory) params.set('category', locals.selectedCategory);
          if (locals.selectedSort) params.set('sort', locals.selectedSort);
          if (locals.searchQuery) params.set('q', locals.searchQuery);
          return '/?' + params.toString();
        }
      %>

      <% if (totalPages > 1) { %>
      <nav class="pagination-wrap" aria-label="Page navigation">
        <!-- Prev -->
        <a href="<%= buildPageUrl(currentPage - 1) %>"
           class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"
           aria-label="Previous">
          <i class="bi bi-chevron-left"></i>
        </a>

        <!-- Page numbers -->
        <% for (let p = 1; p <= totalPages; p++) { %>
          <% if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
            <a href="<%= buildPageUrl(p) %>" class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
          <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
            <span class="page-btn disabled">…</span>
          <% } %>
        <% } %>

        <!-- Next -->
        <a href="<%= buildPageUrl(currentPage + 1) %>"
           class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"
           aria-label="Next">
          <i class="bi bi-chevron-right"></i>
        </a>
      </nav>
      <% } %>

      <% } %>
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 2rem;">
      <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
        <p class="mb-0" style="font-size: 0.85rem; color: var(--text-muted);">
          © <%= new Date().getFullYear() %> <strong>Blog Chunks</strong> · Built with ❤️ By. Rizan Bhandari
        </p>
        <div class="d-flex gap-3">
          <a href="/" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;">Home</a>
          <% if (locals.user) { %>
            <a href="/blog/add-new" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;">Write</a>
          <% } else { %>
            <a href="/user/signup" style="font-size: 0.85rem; color: var(--text-muted); text-decoration: none;">Join</a>
          <% } %>
        </div>
      </div>
    </footer>

    <%- include('./partials/script') %>
  </body>
</html>
