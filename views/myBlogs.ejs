<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>My Articles — Blog Chunks</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container py-5" style="max-width: 920px;">
      <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
          <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>My Articles</h2>
          <p class="text-muted mb-0" style="font-size: 0.875rem;">Manage your published articles and saved drafts</p>
        </div>
        <a href="/blog/add-new" class="btn-hero-primary" style="font-size: 0.9rem; padding: 0.5rem 1.25rem;">
          <i class="bi bi-plus-lg"></i> Create New Article
        </a>
      </div>
      
      <% if (blogs.length === 0) { %>
        <div class="empty-state bg-white rounded-4 border">
          <div class="empty-state-icon"><i class="bi bi-journal-plus"></i></div>
          <h3>You haven't written any articles yet</h3>
          <p>Share your ideas with the community by starting your first post.</p>
          <a href="/blog/add-new" class="btn-hero-primary">
            <i class="bi bi-pencil-square"></i> Write Article Now
          </a>
        </div>
      <% } else { %>
        <div class="list-group shadow-sm border-0 rounded-4 overflow-hidden mb-4">
          <% blogs.forEach(blog => { %>
            <div class="list-group-item list-group-item-action p-3 p-md-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3">
              <div class="d-flex align-items-center gap-3">
                <% if (blog.coverImageURL) { %>
                  <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" width="64" height="64" class="rounded" style="object-fit: cover;" />
                <% } else { %>
                  <div width="64" height="64" class="rounded d-flex align-items-center justify-content-center bg-light border" style="width:64px; height:64px;">
                    <i class="bi bi-file-text text-muted fs-4"></i>
                  </div>
                <% } %>
                <div>
                  <a href="/blog/<%= blog._id %>" class="text-decoration-none text-dark">
                    <h5 class="mb-1 fw-bold"><%= blog.title %></h5>
                  </a>
                  <div class="text-muted d-flex align-items-center gap-3 flex-wrap" style="font-size: 0.825rem;">
                    <span><i class="bi bi-calendar me-1"></i> <%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    <span><i class="bi bi-eye me-1"></i> <%= blog.views %> Views</span>
                    <span><i class="bi bi-heart me-1"></i> <%= blog.likes ? blog.likes.length : 0 %> Likes</span>
                    <% if (blog.category) { %>
                      <span class="badge bg-light text-primary border"><%= blog.category %></span>
                    <% } %>
                  </div>
                </div>
              </div>

              <div class="d-flex gap-2 align-items-center ms-auto">
                <% if (blog.status === 'draft') { %>
                  <span class="badge bg-warning text-dark px-2.5 py-1">Draft</span>
                <% } else { %>
                  <span class="badge bg-success px-2.5 py-1">Published</span>
                <% } %>
                <a href="/blog/edit/<%= blog._id %>" class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <form action="/blog/delete/<%= blog._id %>" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to delete this article?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
        <nav class="pagination-wrap" aria-label="My blogs page navigation">
          <!-- Prev -->
          <a href="/blog/my-blogs?page=<%= currentPage - 1 %>"
             class="page-btn <%= currentPage <= 1 ? 'disabled' : '' %>"
             aria-label="Previous">
            <i class="bi bi-chevron-left"></i>
          </a>

          <!-- Page numbers -->
          <% for (let p = 1; p <= totalPages; p++) { %>
            <% if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) { %>
              <a href="/blog/my-blogs?page=<%= p %>" class="page-btn <%= p === currentPage ? 'active' : '' %>"><%= p %></a>
            <% } else if (p === currentPage - 2 || p === currentPage + 2) { %>
              <span class="page-btn disabled">…</span>
            <% } %>
          <% } %>

          <!-- Next -->
          <a href="/blog/my-blogs?page=<%= currentPage + 1 %>"
             class="page-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"
             aria-label="Next">
            <i class="bi bi-chevron-right"></i>
          </a>
        </nav>
        <% } %>

      <% } %>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
