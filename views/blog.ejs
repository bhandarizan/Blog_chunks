<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Blog</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-4">
      <div class="d-flex justify-content-between align-items-center">
        <h1><%= blog.title %></h1>
        <% if (locals.user && locals.user._id.toString() === blog.createdBy._id.toString()) { %>
          <div class="d-flex gap-2">
            <a href="/blog/edit/<%= blog._id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
            <form action="/blog/delete/<%= blog._id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this blog?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </div>
        <% } %>
      </div>
      <div class="text-muted mb-3 d-flex align-items-center gap-3 flex-wrap">
        <span><i class="bi bi-eye me-1"></i><%= blog.views %> Views</span>
        <span><i class="bi bi-clock me-1"></i><%= blog.readingTime %> Min Read</span>
        <% if (blog.category) { %>
          <span class="badge bg-primary"><%= blog.category %></span>
        <% } %>
        <div class="ms-auto d-flex align-items-center gap-2">
          <% if (locals.user) { %>
            <form action="/blog/<%= blog._id %>/like" method="post" class="m-0">
              <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 border-0 bg-transparent">
                <% if (blog.likes && blog.likes.some(like => like.toString() === locals.user._id.toString())) { %>
                  <i class="bi bi-heart-fill text-danger fs-5"></i>
                <% } else { %>
                  <i class="bi bi-heart text-danger fs-5"></i>
                <% } %>
                <span class="text-dark fw-semibold"><%= blog.likes ? blog.likes.length : 0 %> Likes</span>
              </button>
            </form>
          <% } else { %>
            <div class="d-flex align-items-center gap-1">
              <i class="bi bi-heart text-muted fs-5"></i>
              <span class="text-muted fw-semibold"><%= blog.likes ? blog.likes.length : 0 %> Likes</span>
            </div>
          <% } %>
        </div>
      </div>
      <% if (blog.tags && blog.tags.length > 0) { %>
        <div class="mb-3">
          <% blog.tags.forEach(tag => { %>
            <span class="badge bg-secondary">#<%= tag %></span>
          <% }) %>
        </div>
      <% } %>
      <img src="<%= blog.coverImageURL %>" width="700px" class="img-fluid rounded" />
      <pre class="mt-3"><%= blog.body %></pre>
    </div>

    <div class="container mt-4">
      <hr/>
      <div class="d-flex align-items-center gap-3">
        <a href="/user/profile/<%= blog.createdBy._id %>">
          <img src="<%= blog.createdBy.profileImageURL %>" width="50" height="50" class="rounded-circle border border-2 border-primary" style="object-fit: cover;" />
        </a>
        <div>
          <span class="text-muted d-block" style="font-size: 0.85rem;">Written by</span>
          <a href="/user/profile/<%= blog.createdBy._id %>" class="fw-bold text-decoration-none text-dark fs-5">
            <%= blog.createdBy.fullName %>
          </a>
        </div>
      </div>
    </div>

    <div class="container mt-3">
      <h4>Comments (<%= comments.length %>)</h4>
      <% if (locals.user) { %>
      <form action="/blog/comment/<%= blog._id %>" method="post">
        <div class="mb-3">
          <input
            id="comment-content"
            type="text"
            name="content"
            class="form-control"
            placeholder="Enter your comment"
            required
          />
          <div class="mt-2">
            <button id="comment-add-btn" class="btn btn-sm btn-primary" type="submit" style="display:none;">Add comment</button>
          </div>
        </div>
      </form>

      <% } %>
      <div class="mt-4">
        <% comments.forEach(comment => { %>
        <div class="card mb-3 border-0">
          <div class="card-body bg-light rounded d-flex gap-3 align-items-start">
             <a href="/user/profile/<%= comment.createdBy._id %>">
               <img src="<%= comment.createdBy.profileImageURL %>" width="50" height="50" class="rounded-circle" style="object-fit: cover;" />
             </a>
             <div>
               <div class="d-flex justify-content-between align-items-start">
                 <a href="/user/profile/<%= comment.createdBy._id %>" class="text-decoration-none text-dark">
                   <h6 class="mb-1 fw-bold"><%= comment.createdBy.fullName %></h6>
                 </a>
               </div>
              <small class="text-muted d-block mb-2">
                <time class="comment-time" datetime="<%= new Date(comment.createdAt).toISOString() %>"><%= new Date(comment.createdAt).toLocaleString() %></time>
              </small>
              <pre class="mb-1"><%= comment.content %></pre>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
