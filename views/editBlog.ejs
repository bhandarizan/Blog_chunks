<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Edit Article — Blog Chunks</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container py-5" style="max-width: 800px;">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Edit Article</h2>
        <a href="/blog/<%= blog._id %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> View Article</a>
      </div>

      <% if (locals.error) { %>
        <div class="alert alert-danger flash-alert mb-4" role="alert">
          <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        </div>
      <% } %>

      <form action="/blog/edit/<%= blog._id %>" method="post" enctype="multipart/form-data" class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
        
        <!-- Cover Image -->
        <div class="mb-4">
          <label for="coverImage" class="form-label fw-semibold">Cover Image (Leave empty to keep existing)</label>
          <% if (blog.coverImageURL) { %>
            <div class="mb-2">
              <img src="<%= blog.coverImageURL %>" alt="Current Cover" style="max-height: 140px; border-radius: 8px; object-fit: cover;" class="border" />
            </div>
          <% } %>
          <input
            type="file"
            class="form-control"
            id="coverImage"
            name="coverImage"
            accept="image/*"
          />
        </div>

        <!-- Article Title -->
        <div class="mb-4">
          <label for="title" class="form-label fw-semibold">Article Title <span class="text-danger">*</span></label>
          <input
            type="text"
            class="form-control form-control-lg"
            id="title"
            name="title"
            value="<%= blog.title %>"
            required
          />
        </div>

        <!-- Article Body -->
        <div class="mb-4">
          <label for="body" class="form-label fw-semibold">Article Body <span class="text-danger">*</span></label>
          <textarea name="body" class="form-control" id="body" rows="12" required><%= blog.body %></textarea>
        </div>

        <!-- Category & Tags -->
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="category" class="form-label fw-semibold">Category</label>
            <input type="text" class="form-control" id="category" name="category" value="<%= blog.category || '' %>" />
          </div>
          <div class="col-md-6">
            <label for="tags" class="form-label fw-semibold">Tags (comma-separated)</label>
            <input type="text" class="form-control" id="tags" name="tags" value="<%= blog.tags ? blog.tags.join(', ') : '' %>" />
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-3 pt-3 border-top">
          <button type="submit" name="action" value="publish" class="btn btn-hero-primary px-4">
            <i class="bi bi-check-circle-fill"></i> Save & Publish Updates
          </button>
          <button type="submit" name="action" value="draft" class="btn btn-outline-secondary px-4">
            <i class="bi bi-bookmark"></i> Keep as Draft
          </button>
        </div>
      </form>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
