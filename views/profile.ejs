<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title><%= profileUser.fullName %> - Profile</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-5">
      <!-- Profile Header -->
      <div class="card p-4 shadow-sm mb-5 border-0 bg-light">
        <div class="row align-items-center">
          <div class="col-md-3 text-center mb-3 mb-md-0">
            <img
              src="<%= profileUser.profileImageURL %>"
              alt="<%= profileUser.fullName %>"
              class="rounded-circle border border-3 border-primary shadow"
              style="width: 150px; height: 150px; object-fit: cover;"
            />
          </div>
          <div class="col-md-9">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center">
              <div>
                <h2 class="fw-bold mb-1"><%= profileUser.fullName %></h2>
                <p class="text-muted mb-2"><%= profileUser.email %></p>
              </div>
              <% if (locals.user && locals.user._id.toString() === profileUser._id.toString()) { %>
                <a href="/user/settings" class="btn btn-outline-primary mt-2 mt-md-0">
                  <i class="bi bi-gear-fill me-1"></i> Edit Profile
                </a>
              <% } %>
            </div>

            <p class="mt-3 lead" style="font-size: 1.1rem;">
              <%= profileUser.bio || "No bio added yet." %>
            </p>

            <div class="d-flex gap-3 mt-4">
              <% if (profileUser.twitterURL) { %>
                <a href="<%= profileUser.twitterURL %>" target="_blank" class="text-dark fs-4" title="Twitter/X">
                  <i class="bi bi-twitter-x"></i>
                </a>
              <% } %>
              <% if (profileUser.githubURL) { %>
                <a href="<%= profileUser.githubURL %>" target="_blank" class="text-dark fs-4" title="GitHub">
                  <i class="bi bi-github"></i>
                </a>
              <% } %>
              <% if (profileUser.websiteURL) { %>
                <a href="<%= profileUser.websiteURL %>" target="_blank" class="text-dark fs-4" title="Website">
                  <i class="bi bi-globe"></i>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Blogs section -->
      <h3 class="mb-4 fw-bold">Published Chunks (<%= blogs.length %>)</h3>
      <% if (blogs.length === 0) { %>
        <div class="alert alert-info py-4 text-center border-0 rounded-3 shadow-sm">
          <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
          This user hasn't published any blogs yet.
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
          <% blogs.forEach(blog => { %>
            <div class="col">
              <div class="card h-100 shadow-sm border-0">
                <div style="height: 200px; overflow: hidden; background-color: #f0f0f0;">
                  <img
                    src="<%= blog.coverImageURL %>"
                    alt="<%= blog.title %>"
                    class="card-img-top w-100 h-100"
                    style="object-fit: cover;"
                  />
                </div>
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <% if (blog.category) { %>
                      <span class="badge bg-primary"><%= blog.category %></span>
                    <% } else { %>
                      <span></span>
                    <% } %>
                    <small class="text-muted"><%= blog.readingTime %> min read</small>
                  </div>
                  <h5 class="card-title fw-bold"><%= blog.title %></h5>
                  <p class="card-text text-muted" style="font-size: 0.9rem;">
                    <%= blog.views %> views &bull; <%= blog.likes.length %> likes
                  </p>
                  <a href="/blog/<%= blog._id %>" class="btn btn-outline-primary mt-auto w-100">Read Article</a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%- include('./partials/script') %>
  </body>
</html>
