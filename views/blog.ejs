<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title><%= blog.title %> — Blog Chunks</title>

    <% 
      const fontGoogleMap = {
        'Merriweather': 'Merriweather:ital,wght@0,300;0,400;0,700',
        'Playfair Display': 'Playfair+Display:ital,wght@0,400;0,600;0,700',
        'Poppins': 'Poppins:wght@300;400;500;600;700',
        'Lora': 'Lora:ital,wght@0,400;0,600;1,400',
        'Fira Code': 'Fira+Code:wght@400;500;600',
        'Cinzel': 'Cinzel:wght@400;600;700',
        'Space Grotesk': 'Space+Grotesk:wght@400;500;600'
      };
      
      let fontCssFamily = "'Inter', -apple-system, sans-serif";
      if (blog.fontUrl) {
        fontCssFamily = "'AuthorCustomFont', 'Inter', sans-serif";
      } else if (blog.fontFamily && blog.fontFamily !== 'Inter') {
        fontCssFamily = `'${blog.fontFamily}', sans-serif`;
      }

      let fontCssSize = blog.fontSize === 'xlarge' ? '1.3rem' : (blog.fontSize === 'large' ? '1.2rem' : '1.125rem');
      let fontCssLine = blog.lineHeight === 'loose' ? '2.0' : (blog.lineHeight === 'relaxed' ? '1.85' : '1.75');
      let fontCssColor = blog.fontColor || '#334155';
    %>

    <% if (blog.fontUrl) { %>
      <style>
        @font-face {
          font-family: 'AuthorCustomFont';
          src: url('<%= blog.fontUrl %>');
          font-display: swap;
        }
      </style>
    <% } else if (blog.fontFamily && fontGoogleMap[blog.fontFamily]) { %>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=<%= fontGoogleMap[blog.fontFamily] %>&display=swap">
    <% } %>

    <style>
      .blog-content {
        font-family: var(--custom-font-family, 'Inter', -apple-system, sans-serif);
        font-size: var(--custom-font-size, 1.125rem);
        line-height: var(--custom-line-height, 1.85);
        color: var(--custom-font-color, #334155);
        white-space: pre-wrap;
        word-wrap: break-word;
      }
    </style>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <%
      // Backend automatic multi-page calculation
      let pages = [];
      if (blog.body && (blog.body.includes('<!-- pagebreak -->') || blog.body.includes('---page---') || blog.body.includes('[pagebreak]'))) {
        pages = blog.body.split(/(?:<!--\s*pagebreak\s*-->|---page---|\[pagebreak\])/i);
      } else if (blog.body) {
        const paragraphs = blog.body.split(/\n\s*\n/).filter(p => p.trim().length > 0);
        const PARAGRAPHS_PER_PAGE = 4;
        if (paragraphs.length > PARAGRAPHS_PER_PAGE) {
          for (let i = 0; i < paragraphs.length; i += PARAGRAPHS_PER_PAGE) {
            pages.push(paragraphs.slice(i, i + PARAGRAPHS_PER_PAGE).join('\n\n'));
          }
        } else {
          pages = [blog.body];
        }
      } else {
        pages = [""];
      }

      const activePageIndex = Math.min(Math.max(1, parseInt(locals.reqPage || 1)), pages.length);
      const currentPageContent = pages[activePageIndex - 1];
    %>

    <main class="container py-5">
      <!-- Main Article Card -->
      <article class="article-container mb-5">
        
        <!-- Cover image: Top Centered Clean Hero Layout (No text overlay) -->
        <% if (blog.coverImageURL) { %>
          <div class="article-hero-wrap">
            <img src="<%= blog.coverImageURL %>" alt="<%= blog.title %>" class="article-hero-img" />
          </div>
        <% } %>

        <!-- Article Content Wrapper -->
        <div class="p-4 p-md-5">
          <!-- Category & Actions Row -->
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div>
              <% if (blog.category) { %>
                <span class="badge bg-primary px-3 py-2 text-uppercase" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                  <%= blog.category %>
                </span>
              <% } %>
            </div>

            <% if (locals.user && locals.user._id.toString() === blog.createdBy._id.toString()) { %>
              <div class="d-flex gap-2 ms-auto">
                <a href="/blog/edit/<%= blog._id %>" class="btn btn-sm btn-outline-secondary">
                  <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <form action="/blog/delete/<%= blog._id %>" method="post" onsubmit="return confirm('Are you sure you want to delete this article?');" class="m-0">
                  <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                  </button>
                </form>
              </div>
            <% } %>
          </div>

          <!-- Title -->
          <h1 class="display-5 fw-bold mb-4" style="color: var(--dark); line-height: 1.25; letter-spacing: -0.5px;">
            <%= blog.title %>
          </h1>

          <!-- Meta bar -->
          <div class="text-muted pb-4 mb-4 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-3" style="font-size: 0.9rem;">
            <div class="d-flex align-items-center gap-3 flex-wrap">
              <a href="/user/profile/<%= blog.createdBy._id %>" class="d-flex align-items-center gap-2 text-decoration-none text-dark">
                <img src="<%= blog.createdBy.profileImageURL %>" width="40" height="40" class="rounded-circle border" style="object-fit: cover;" />
                <span class="fw-semibold"><%= blog.createdBy.fullName %></span>
              </a>
              <span><i class="bi bi-calendar me-1 text-primary"></i><%= new Date(blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
              <span><i class="bi bi-eye me-1 text-primary"></i><%= blog.views %> views</span>
              <span><i class="bi bi-clock me-1 text-primary"></i><%= blog.readingTime %> min read</span>
            </div>

            <!-- Like Button -->
            <div class="d-flex align-items-center">
              <% if (locals.user) { %>
                <form action="/blog/<%= blog._id %>/like" method="post" class="m-0">
                  <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 border-0 bg-light px-3 py-1.5 rounded-pill">
                    <% if (blog.likes && blog.likes.some(like => like.toString() === locals.user._id.toString())) { %>
                      <i class="bi bi-heart-fill text-danger fs-6"></i>
                    <% } else { %>
                      <i class="bi bi-heart text-danger fs-6"></i>
                    <% } %>
                    <span class="text-dark fw-bold" style="font-size: 0.85rem;"><%= blog.likes ? blog.likes.length : 0 %> Likes</span>
                  </button>
                </form>
              <% } else { %>
                <div class="d-flex align-items-center gap-1 bg-light px-3 py-1.5 rounded-pill">
                  <i class="bi bi-heart text-muted fs-6"></i>
                  <span class="text-muted fw-bold" style="font-size: 0.85rem;"><%= blog.likes ? blog.likes.length : 0 %> Likes</span>
                </div>
              <% } %>
            </div>
          </div>

          <!-- Tags -->
          <% if (blog.tags && blog.tags.length > 0) { %>
            <div class="mb-4 d-flex flex-wrap gap-1">
              <% blog.tags.forEach(tag => { %>
                <span class="tag-pill">#<%= tag %></span>
              <% }) %>
            </div>
          <% } %>

          <!-- Article Body -->
          <div 
            class="blog-content mb-4" 
            id="article-body-content"
            style="--custom-font-family: <%= fontCssFamily %>; --custom-font-size: <%= fontCssSize %>; --custom-line-height: <%= fontCssLine %>; --custom-font-color: <%= fontCssColor %>;"
          ><%= currentPageContent %></div>

          <!-- Automatic Multi-Page Pagination Navigation (if content spans > 1 page) -->
          <% if (pages.length > 1) { %>
            <div class="multi-page-nav-wrap">
              <span class="text-muted" style="font-size: 0.85rem;">Page <%= activePageIndex %> of <%= pages.length %></span>
              <div class="multi-page-pills">
                <button type="button" class="multi-page-btn <%= activePageIndex <= 1 ? 'disabled' : '' %>" data-page="<%= activePageIndex - 1 %>" onclick="switchArticlePage(this.dataset.page)">
                  <i class="bi bi-chevron-left"></i> Prev
                </button>
                <% for (let p = 1; p <= pages.length; p++) { %>
                  <button type="button" class="multi-page-btn <%= p === activePageIndex ? 'active' : '' %>" data-page="<%= p %>" onclick="switchArticlePage(this.dataset.page)">
                    <%= p %>
                  </button>
                <% } %>
                <button type="button" class="multi-page-btn <%= activePageIndex >= pages.length ? 'disabled' : '' %>" data-page="<%= activePageIndex + 1 %>" onclick="switchArticlePage(this.dataset.page)">
                  Next <i class="bi bi-chevron-right"></i>
                </button>
              </div>
            </div>
          <% } %>

        </div>
      </article>

      <!-- Author Bio -->
      <div class="card border-0 shadow-sm p-3 mb-5" style="max-width: 920px; margin: 0 auto; background: #fff; border-radius: var(--radius);">
        <div class="d-flex align-items-center gap-3">
          <a href="/user/profile/<%= blog.createdBy._id %>">
            <img src="<%= blog.createdBy.profileImageURL %>" width="60" height="60" class="rounded-circle border border-2 border-primary" style="object-fit: cover;" />
          </a>
          <div>
            <span class="text-muted d-block" style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Written by</span>
            <a href="/user/profile/<%= blog.createdBy._id %>" class="fw-bold text-decoration-none text-dark fs-5">
              <%= blog.createdBy.fullName %>
            </a>
          </div>
        </div>
      </div>

      <!-- Comments Section -->
      <div style="max-width: 920px; margin: 0 auto;">
        <h4 class="mb-3 font-weight-bold">Comments (<%= comments.length %>)</h4>
        <% if (locals.user) { %>
        <form action="/blog/comment/<%= blog._id %>" method="post" class="mb-4">
          <div class="input-group">
            <input
              id="comment-content"
              type="text"
              name="content"
              class="form-control form-control-lg"
              placeholder="Share your thoughts..."
              required
            />
            <button class="btn btn-primary px-4" type="submit">Post Comment</button>
          </div>
        </form>
        <% } else { %>
          <div class="alert alert-light border mb-4">
            Please <a href="/user/signin" class="fw-bold">Sign In</a> to join the conversation.
          </div>
        <% } %>

        <div class="comments-list">
          <% comments.forEach(comment => { %>
          <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body rounded d-flex gap-3 align-items-start" style="background-color: #fff; border: 1px solid var(--border);">
               <a href="/user/profile/<%= comment.createdBy._id %>">
                 <img src="<%= comment.createdBy.profileImageURL %>" width="46" height="46" class="rounded-circle" style="object-fit: cover; border: 1.5px solid var(--border);" />
               </a>
               <div class="w-100">
                 <div class="d-flex justify-content-between align-items-center mb-1">
                   <a href="/user/profile/<%= comment.createdBy._id %>" class="text-decoration-none text-dark">
                     <h6 class="mb-0 fw-bold"><%= comment.createdBy.fullName %></h6>
                   </a>
                   <small class="text-muted" style="font-size: 0.78rem;">
                    <%= new Date(comment.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                   </small>
                 </div>
                <div class="comment-text mt-1" style="font-size: 0.95rem; color: #334155; white-space: pre-wrap;"><%= comment.content %></div>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </main>

    <%- include('./partials/script') %>

    <script>
      function switchArticlePage(pageNum) {
        if (!pageNum) return;
        const url = new URL(window.location.href);
        url.searchParams.set('p', pageNum);
        window.location.href = url.toString();
      }
    </script>
  </body>
</html>
