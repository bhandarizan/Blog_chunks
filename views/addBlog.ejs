<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Add New Blog</title>
  </head>
  <body>
    <%- include('./partials/nav') %>

    <div class="container mt-3">
      <form action="/blog" method="post" enctype="multipart/form-data">
        <div class="mb-3">
          <label for="coverImage" class="form-label">Cover Image</label>
          <input
            type="file"
            class="form-control"
            id="coverImage"
            name="coverImage"
            aria-describedby="coverImage"
          />
        </div>
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            aria-describedby="title"
          />
        </div>
        <div class="mb-3">
          <label for="body">Body</label>
          <textarea name="body" class="form-control" id="body" rows="5"></textarea>
        </div>

        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <input type="text" class="form-control" id="category" name="category" placeholder="e.g. Technology" />
        </div>
        <div class="mb-3">
          <label for="tags" class="form-label">Tags (comma-separated)</label>
          <input type="text" class="form-control" id="tags" name="tags" placeholder="e.g. javascript, webdev" />
        </div>
        <div class="mb-3 d-flex gap-2">
          <button type="submit" name="action" value="publish" class="btn btn-primary">Publish</button>
          <button type="submit" name="action" value="draft" class="btn btn-outline-secondary">Save Draft</button>
        </div>
      </form>
    </div>

    <%- include('./partials/script') %>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const form = document.querySelector('form[action="/blog"]');
        const fields = ['title', 'body', 'category', 'tags'];
        
        // Restore values
        fields.forEach(field => {
          const el = document.getElementById(field);
          if (el) {
            const savedValue = localStorage.getItem(`blogDraft_${field}`);
            if (savedValue) {
              el.value = savedValue;
            }
            
            // Save on input
            el.addEventListener('input', () => {
              localStorage.setItem(`blogDraft_${field}`, el.value);
            });
          }
        });

        // Clear values on submit
        form.addEventListener('submit', () => {
          fields.forEach(field => {
            localStorage.removeItem(`blogDraft_${field}`);
          });
        });
      });
    </script>
  </body>
</html>
